PORT=3000
DATABASE_URL=postgres://avnadmin:password@host.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nPASTE_AIVEN_CA_CERTIFICATE_HERE\n-----END CERTIFICATE-----
AUTH_SECRET=replace-with-at-least-32-random-characters
MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional persistent HLS storage for Reel segments
REEL_HLS_ROOT=/home/opc/facebook-media/reels-hls

# File-backed Create Post videos
POST_VIDEO_FILE_ROOT=/home/opc/facebook-media/post-videos
